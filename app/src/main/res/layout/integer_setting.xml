<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"> <!-- Permette al layout di riprendersi il focus -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:padding="10dp"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="5dp">

            <TextView
                android:id="@+id/integer_setting_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAlignment="textStart"
                android:layout_weight="1"
                android:textSize="20sp"
                android:layout_marginLeft="10dp"/>

            <EditText
                android:id="@+id/integer_setting_input"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:inputType="number"
                android:imeOptions="actionDone"/> <!-- Specifica l'azione "Fatto/OK" della tastiera -->
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>